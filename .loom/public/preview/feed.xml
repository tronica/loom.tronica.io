    <item>
      <title>Games Tracker</title>
      <link>https://loom.tronica.io/media/2026-04-28-upcoming-games-2026/</link>
      <pubDate>2026-04-28</pubDate>
      <guid isPermaLink="true">https://loom.tronica.io/media/2026-04-28-upcoming-games-2026/</guid>
      <description>
&lt;style&gt;
  .games-container {
    max-width: var(--wide-w);
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .games-masthead {
    margin-bottom: 2rem;
  }

  .games-masthead h1 {
    font-size: 2.2rem;
    color: var(--mauve);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
    font-family: &quot;Bitcount Grid Double&quot;, monospace, sans-serif;
  }

  .games-masthead h1::before {
    content: &quot;~/media/&quot;;
    color: var(--text-3);
    font-family: var(--font);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    margin-right: 0.5rem;
  }

  .games-subtitle {
    color: var(--text-3);
    font-size: 0.8rem;
    font-style: italic;
  }

  .games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .game-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--bg-2);
    border: 1px solid var(--border-hi);
    padding: 1rem;
    transition:
      border-color 0.12s,
      background 0.12s;
  }

  .game-card:hover {
    border-color: var(--border-act);
    background: var(--surface);
  }

  .game-card:hover .game-title {
    color: var(--mauve);
  }

  .game-image-placeholder {
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--surface-2);
    border: 1px solid var(--border);
    margin-bottom: 0.75rem;
    font-size: 3rem;
    font-weight: 300;
    color: var(--text-3);
    overflow: hidden;
  }

  .game-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
    margin-bottom: 0.5rem;
    transition: color 0.12s;
  }

  .game-title a {
    color: inherit;
    text-decoration: none;
  }

  .game-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }

  .badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border-hi);
    background: var(--surface-2);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-2);
  }

  .badge-ps5 { border-color: var(--blue); color: var(--blue); }
  .badge-pc { border-color: var(--text-3); color: var(--text-3); }
  .badge-xbox { border-color: var(--green); color: var(--green); }
  .badge-nintendo { border-color: var(--peach); color: var(--peach); }
  .badge-confirmed { border-color: var(--green); color: var(--green); }
  .badge-tba { border-color: var(--yellow); color: var(--yellow); }
  .badge-rumoured { border-color: var(--red); color: var(--red); }
  .badge-delayed { border-color: var(--red); color: var(--red); }

  .release-badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border-act);
    background: rgba(203, 166, 247, 0.1);
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--mauve);
    margin-left: auto;
  }

  .release-released {
    border-color: var(--green);
    background: rgba(166, 227, 161, 0.1);
    color: var(--green);
  }

  .game-description {
    font-size: 0.8rem;
    color: var(--text-2);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .sources-panel {
    margin-top: 2rem;
  }

  .sources-panel-title {
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    left: 1rem;
    padding: 0 0.4rem;
