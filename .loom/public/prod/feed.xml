    font-size: 0.8rem;
    font-style: italic;
  }

  .ranking-table-container {
    overflow-x: auto;
    margin-bottom: 2rem;
  }

  .ranking-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-2);
    border: 1px solid var(--border-hi);
  }

  .ranking-table th {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-2);
    font-weight: 600;
  }

  .ranking-table td {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    font-size: 0.85rem;
    color: var(--text);
  }

  .ranking-table tr:hover {
    background: var(--surface);
  }

  .rank-cell {
    width: 50px;
    font-weight: 700;
    color: var(--mauve);
    font-size: 1.1rem;
  }

  .model-cell {
    font-weight: 600;
  }

  .model-cell a {
    color: var(--text);
    text-decoration: none;
  }

  .model-cell a:hover {
    color: var(--mauve);
    text-decoration: underline;
  }

  .provider-cell {
    color: var(--text-2);
    font-size: 0.8rem;
  }

  .score-cell {
    font-weight: 600;
    color: var(--green);
  }

  .category-cell {
    font-size: 0.75rem;
  }

  .badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--border-hi);
    background: var(--surface-2);
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-2);
    margin-right: 0.4rem;
  }

  .badge-llm { border-color: var(--blue); color: var(--blue); }
  .badge-vision { border-color: var(--green); color: var(--green); }
  .badge-multimodal { border-color: var(--peach); color: var(--peach); }
  .badge-audio { border-color: var(--purple); color: var(--purple); }
  .badge-code { border-color: var(--yellow); color: var(--yellow); }

  .last-updated-cell {
    color: var(--text-3);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .notes-cell {
    font-size: 0.75rem;
    color: var(--text-2);
  }

  .sources-panel {
    margin-top: 2rem;
  }

  .sources-panel-title {
    position: absolute;
    top: 0;
    transform: translateY(-50%);
    left: 1rem;
    padding: 0 0.4rem;
    background: var(--bg);
    font-size: 0.72rem;
    color: var(--text-3);
    white-space: nowrap;
  }

  .sources-panel-title .hi {
    color: var(--blue);
  }

  .sources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0.75rem;
    padding-top: 0.75rem;
  }

  .source-item {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--border);
  }

  .source-item:last-child {
    border-bottom: none;
  }

  .source-item a {
    color: var(--cyan);
    text-decoration: none;
    font-size: 0.8rem;
    word-break: break-all;
    display: block;
  }

  .source-item a:hover {
    color: var(--mauve);
    text-decoration: underline;
  }

  .source-meta {
    font-size: 0.7rem;
    color: var(--text-3);
    margin-top: 0.2rem;
  }

  .updated-note {
    font-size: 0.75rem;
    color: var(--text-3);
    margin-top: 1.5rem;
    text-align: center;
    font-style: italic;
  }

  .methodology {
    margin-top: 2rem;
    padding: 1rem;
    background: var(--bg-2);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-2);
    line-height: 1.6;
  }

  .methodology-title {
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  @media (max-width: 768px) {
    .models-container {
      padding: 1.5rem 1rem;
    }
    .models-masthead h1 {
      font-size: 1.6rem;
    }
    .ranking-table th,
    .ranking-table td {
      padding: 0.5rem 0.75rem;
      font-size: 0.75rem;
    }
  }
