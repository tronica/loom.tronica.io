      <description>
&lt;style&gt;
  .models-container {
    max-width: var(--wide-w);
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .models-masthead {
    margin-bottom: 2rem;
  }

  .models-masthead h1 {
    font-size: 2.2rem;
    color: var(--mauve);
